# ==============================================================================
# OKX-CEX CROSS-MARKET ARBITRAGE BOT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CEX API KEYS (Public market data works WITHOUT keys; keys needed for live execution)
# ------------------------------------------------------------------------------
# Binance API (Permissions required: Spot Trading only; DO NOT enable Withdrawals)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Gate.io API (Permissions: Spot Trading only; DO NOT enable Withdrawals)
GATE_API_KEY=
GATE_API_SECRET=

# OKX API (Web3 & CEX market data and quotes)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=

# ------------------------------------------------------------------------------
# 2. EVM ON-CHAIN SETTINGS (BSC Mainnet / Chain ID 56)
# ------------------------------------------------------------------------------
# Dedicated BSC RPC Node URL (e.g. QuickNode, Alchemy, Nodereal, or public fallback)
EVM_RPC_URL=https://bsc-dataseed.bnbchain.org

# Hot Wallet Public Address (Used for pre-trade balance check & calldata recipient validation)
WALLET_ADDRESS=

# Hot Wallet Private Key (Optional for Read-Only / Paper modes; required ONLY for Live trading)
EVM_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 3. SAFETY & LIVE TRADING LOCKS (Double-Protection Gate)
# ------------------------------------------------------------------------------
# Must be explicitly set to 'true' to execute real funds with --live flag
CONFIRM_LIVE_TRADING=false

# Strategy Parameters
MIN_SPREAD_PCT=0.5
REFRESH_INTERVAL_SEC=20
